{
  "name": "clipper",
  "version": "0.1.0",
  "private": true,
  "description": "Clipper — upload, transcode, and stream video (pnpm monorepo).",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @clipper/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm -r run test",
    "typecheck": "pnpm build && pnpm -r run typecheck",
    "cdk:synth": "pnpm --filter @clipper/infra synth",
    "cdk:deploy": "pnpm --filter @clipper/infra run deploy",
    "cdk:destroy": "pnpm --filter @clipper/infra destroy"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
