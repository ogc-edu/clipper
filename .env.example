# Clipper — local environment template.
#
# Copy this file to `.env` (git-ignored) or export the variables in your
# shell before running any `cdk` command. See docs/RUNBOOK.md.
#
# The ops-alerts SNS email subscription is created from this address, so a
# real inbox is required to receive DLQ alarm notifications. NEVER commit a
# real address — this repository must not contain personal data.
OPS_ALERTS_EMAIL="ops@example.com"
